# Copy to .env for local development. On Render, add these under Environment.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME
DATABASE_SSL=true
JWT_SECRET=paste-a-long-random-string-here
ADMIN_EMAIL=hello@usamasheikh.com
# Admin password (12+ characters). Or set ADMIN_PASSWORD_HASH instead (npm run hash-password).
ADMIN_PASSWORD=
ALLOWED_ORIGINS=https://usamasheikh.com,https://www.usamasheikh.com
PUBLIC_API_URL=https://usama-portfolio-backend-16jd.onrender.com

# Email for new leads (Hostinger email: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@usamasheikh.com
SMTP_PASS=
LEADS_TO=hello@usamasheikh.com
MAIL_FROM=Usama Sheikh <hello@usamasheikh.com>

# Publish button: a fine-grained GitHub token with "Actions: read and write" on this repo only
GITHUB_TOKEN=
GITHUB_REPO=iamusamasheikh/redesign-v2
GITHUB_WORKFLOW=deploy.yml
GITHUB_REF=main
